Ontology: <http://iso20022.example/ontology>

Datatype: LEI20
    Annotations: rdfs:label "LEI20"
    EquivalentTo:
        xsd:string
            pattern "^[A-Z0-9]{20}$"
            minLength 20
            maxLength 20

Datatype: BIC11
    Annotations: rdfs:label "BIC11"
    EquivalentTo:
        xsd:string
            pattern "^[A-Z]{4}[A-Z]{2}[A-Z0-9]{2}[A-Z0-9]{3}$"
            minLength 11
            maxLength 11

Class: PartyIdentification
    Annotations:
        rdfs:label "PartyIdentification",
        rdfs:comment "Party identification container"@en

Class: PartyIdentificationLEI
    Annotations: rdfs:label "PartyIdentificationLEI"
    SubClassOf:
        LEI some LEI20

Class: PartyIdentificationBIC
    Annotations: rdfs:label "PartyIdentificationBIC"
    SubClassOf:
        BIC some BIC11

Class: PartyIdChoice
    Annotations: rdfs:label "PartyIdChoice"
    EquivalentTo:
        PartyIdentificationLEI or PartyIdentificationBIC
    DisjointWith:
        PartyIdentificationLEI,
        PartyIdentificationBIC

Individual: iso:GBP
    Types: CurrencyCode
    Annotations: rdfs:label "GBP", rdfs:comment "Pound Sterling"@en
