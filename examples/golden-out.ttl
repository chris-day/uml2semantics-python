@prefix iso: <http://iso20022.example/ontology#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

iso:Ontology a owl:Ontology ;
    iso:release "2025-06"^^xsd:gYearMonth .

iso:PartyIdentification a owl:Class ;
    rdfs:label "PartyIdentification" ;
    rdfs:comment "Party identification container"@en .

iso:PartyIdentificationLEI a owl:Class ;
    rdfs:label "PartyIdentificationLEI" .

iso:PartyIdentificationBIC a owl:Class ;
    rdfs:label "PartyIdentificationBIC" .

iso:PartyIdChoice a owl:Class ;
    rdfs:label "PartyIdChoice" ;
    owl:equivalentClass [
        owl:unionOf (
            iso:PartyIdentificationLEI
            iso:PartyIdentificationBIC
        )
    ] ;
    owl:disjointWith iso:PartyIdentificationLEI ,
                     iso:PartyIdentificationBIC .

iso:LEI20 a rdfs:Datatype ;
    rdfs:label "LEI20" ;
    owl:equivalentClass [
        a owl:DatatypeRestriction ;
        owl:onDatatype xsd:string ;
        owl:withRestrictions (
            [ xsd:pattern "^[A-Z0-9]{20}$" ]
            [ xsd:minLength "20"^^xsd:integer ]
            [ xsd:maxLength "20"^^xsd:integer ]
        )
    ] .

iso:BIC11 a rdfs:Datatype ;
    rdfs:label "BIC11" ;
    owl:equivalentClass [
        a owl:DatatypeRestriction ;
        owl:onDatatype xsd:string ;
        owl:withRestrictions (
            [ xsd:pattern "^[A-Z]{4}[A-Z]{2}[A-Z0-9]{2}[A-Z0-9]{3}$" ]
            [ xsd:minLength "11"^^xsd:integer ]
            [ xsd:maxLength "11"^^xsd:integer ]
        )
    ] .

iso:LEI a owl:DatatypeProperty ;
    rdfs:domain iso:PartyIdentificationLEI ;
    rdfs:range iso:LEI20 ;
    owl:cardinality 1 .

iso:BIC a owl:DatatypeProperty ;
    rdfs:domain iso:PartyIdentificationBIC ;
    rdfs:range iso:BIC11 ;
    owl:cardinality 1 .

iso:CurrencyCode a owl:Class ;
    rdfs:label "CurrencyCode" .

iso:GBP a iso:CurrencyCode ;
    rdfs:label "GBP" ;
    rdfs:comment "Pound Sterling"@en .

iso:EUR a iso:CurrencyCode ;
    rdfs:label "EUR" ;
    rdfs:comment "Euro"@en .
